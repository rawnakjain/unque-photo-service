# Salon Management POC Environment Configuration
# Copy this file to .env and fill in the real values.

# Google Gemini (Vertex AI) settings
# gemini-3.5-flash-lite: ~4-5x faster end-to-end than gemini-2.5-flash-lite on dense
# menus and more accurate. Gemini 3.x models are served from the "global" location.
GEMINI_MODEL="gemini-3.5-flash-lite"
# Tried automatically if the primary model errors (outage, quota, retirement). Empty disables.
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
GCP_PROJECT_ID=""
GCP_LOCATION="global"

# Extraction tuning
GEMINI_MAX_IMAGE_DIM="2000"
# Gemini 3.x+ uses a thinking level (LOW measured most accurate at no latency cost;
# MEDIUM is 3-4x slower). Gemini 2.x uses a token budget instead (0 = off).
GEMINI_THINKING_LEVEL="LOW"
GEMINI_THINKING_BUDGET="0"
# Empty = model default (best for 3.x). Use "MEDIUM" if you run gemini-2.5-flash-lite.
GEMINI_MEDIA_RESOLUTION=""
GEMINI_MAX_OUTPUT_TOKENS="8192"
GEMINI_TIMEOUT_S="60"
GEMINI_MAX_ATTEMPTS="3"
# Duplicate the request if nothing has streamed after this many seconds (0 disables).
GEMINI_HEDGE_AFTER_S="3.5"

# MongoDB Atlas configuration
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>"
MONGODB_DB_NAME="Unque"
MONGODB_TIMEOUT_MS="5000"
MONGODB_MIN_POOL_SIZE="8"
FUZZY_SEARCH_WORKERS="16"

# Collections used for fuzzy search
SALONSERVICES_COLLECTION="salonservices"
SALONSERVICEVARIATIONS_COLLECTION="salonservicevariations"

# Atlas Search index names (one per collection)
SALONSERVICES_TEXT_INDEX="salonservices_index"
SALONSERVICEVARIATIONS_TEXT_INDEX="salonservicevariations_index"

# Embedding model (kept for potential future use)
EMBEDDING_MODEL_NAME="BAAI/bge-m3"
EMBEDDING_DEVICE="cpu"
